#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
import tempfile
from pathlib import Path


SCRIPT_DIR = Path(__file__).resolve().parent
ROOT = SCRIPT_DIR.parents[1]
sys.path.insert(0, str(SCRIPT_DIR))

from rc_schema_adapter import run_candidate_demo  # noqa: E402


def main() -> None:
    parser = argparse.ArgumentParser(
        description="FilmOS pinned Candidate synthetic schema migration drill"
    )
    parser.add_argument(
        "--synthetic",
        action="store_true",
        help="required acknowledgement that no real database may be opened",
    )
    args = parser.parse_args()
    if not args.synthetic:
        parser.error("--synthetic is required; real databases are not accepted")
    with tempfile.TemporaryDirectory(prefix="filmos-rc-candidate-") as directory:
        print(
            json.dumps(
                run_candidate_demo(directory, ROOT),
                ensure_ascii=False,
                indent=2,
            )
        )


if __name__ == "__main__":
    main()
