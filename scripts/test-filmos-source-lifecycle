#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
source_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
launcher="$script_dir/filmos-source-start"
double_click_entry="$source_root/源码启动.command"
runtime_root="$source_root/.local/source-host"
helpers="$runtime_root/Helpers"
backend_helper="$helpers/FilmOSBackend"
compiled_backend="$runtime_root/Compiled/FilmOSBackend"
canonical_db="$HOME/Library/Application Support/FilmOS Studio/WorkbenchData/open_ai_canvas.db"
source_ports="43100 43101 17371 17650 17920"
python_bin="$source_root/.local/acceptance-venv/bin/python"
evidence_parent=${FILMOS_SOURCE_LIFECYCLE_EVIDENCE_ROOT:-"$source_root/.local/governance-v11-final/source-lifecycle"}
run_id=$(/bin/date -u '+%Y%m%dT%H%M%SZ')-$$
evidence_root="$evidence_parent/$run_id"
trace_path="$evidence_root/trace.jsonl"
cycles_path="$evidence_root/cycles.tsv"
before_data_path="$evidence_root/data-before.json"
after_data_path="$evidence_root/data-after.json"
result_path="$evidence_root/result.json"
receipt_path="$evidence_root/receipt.json"
backend_backup="$runtime_root/FilmOSBackend.lifecycle-original"
was_running=false
finished=false

if [ -x /opt/homebrew/bin/node ]; then
    node_bin=/opt/homebrew/bin/node
else
    node_bin=$(command -v node)
fi

fail() {
    echo "FILMOS_SOURCE_LIFECYCLE_FAILED:$1" >&2
    exit 1
}

hash_file() {
    /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'
}

monotonic_ns() {
    "$python_bin" -c 'import time; print(time.monotonic_ns())'
}

test_launcher() {
    /usr/bin/env \
        FILMOS_SOURCE_LIFECYCLE_TEST_MODE=1 \
        FILMOS_SOURCE_USE_PREPARED_RUNTIME=1 \
        "$launcher" "$@"
}

test_double_click_entry() {
    /usr/bin/env \
        FILMOS_SOURCE_LIFECYCLE_TEST_MODE=1 \
        FILMOS_SOURCE_USE_PREPARED_RUNTIME=1 \
        "$double_click_entry"
}

source_state_is() {
    expected_state=$1
    status_output=$("$launcher" status)
    case "$status_output" in
        *"state=$expected_state "*) return 0 ;;
        *) return 1 ;;
    esac
}

ports_free() {
    for port_number in $source_ports; do
        if /usr/sbin/lsof -nP -iTCP:"$port_number" -sTCP:LISTEN >/dev/null 2>&1; then
            return 1
        fi
    done
}

listener_pids() {
    for port_number in $source_ports; do
        /usr/sbin/lsof -nP -t -iTCP:"$port_number" -sTCP:LISTEN 2>/dev/null || true
    done | /usr/bin/awk '!seen[$0]++' | /usr/bin/sort -n
}

trace_event() {
    event=$1
    cycle=$2
    status=$3
    detail=${4:-none}
    "$node_bin" - "$trace_path" "$event" "$cycle" "$status" "$detail" <<'NODE'
const { appendFileSync } = require("node:fs");
const [path, event, cycle, status, detail] = process.argv.slice(2);
appendFileSync(path, `${JSON.stringify({
  schema_version: "filmos.source-lifecycle-trace.v1",
  event,
  cycle: Number(cycle),
  status,
  detail,
})}\n`);
NODE
}

data_snapshot() {
    destination=$1
    if [ ! -f "$canonical_db" ]; then
        printf '%s\n' '{"database_present":false,"project_count":0,"canvas_count":0,"unit_count":0,"rows_sha256":"none"}' > "$destination"
        return
    fi
    project_count=$(sqlite3 -readonly "$canonical_db" 'SELECT count(*) FROM projects;')
    canvas_count=$(sqlite3 -readonly "$canonical_db" 'SELECT count(*) FROM canvas_projects;')
    unit_count=$(sqlite3 -readonly "$canonical_db" 'SELECT count(*) FROM project_units;')
    rows_sha256=$(
        sqlite3 -readonly "$canonical_db" \
            "SELECT 'project|'||id||'|'||name||'|'||revision FROM projects ORDER BY id;
             SELECT 'canvas|'||id||'|'||project_id||'|'||title FROM canvas_projects ORDER BY id;
             SELECT 'unit|'||id||'|'||project_id||'|'||title||'|'||position FROM project_units ORDER BY id;" \
            | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}'
    )
    "$node_bin" - "$destination" "$project_count" "$canvas_count" "$unit_count" "$rows_sha256" <<'NODE'
const { renameSync, writeFileSync } = require("node:fs");
const [path, projectCount, canvasCount, unitCount, rowsSHA256] = process.argv.slice(2);
const temporary = `${path}.tmp-${process.pid}`;
writeFileSync(temporary, `${JSON.stringify({
  database_present: true,
  project_count: Number(projectCount),
  canvas_count: Number(canvasCount),
  unit_count: Number(unitCount),
  rows_sha256: rowsSHA256,
}, null, 2)}\n`, { mode: 0o600 });
renameSync(temporary, path);
NODE
}

project_context() {
    response=$(/usr/bin/curl -fsS --max-time 5 http://127.0.0.1:43101/api/projects)
    project_count=$(printf '%s' "$response" | "$node_bin" -e '
let source = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (chunk) => source += chunk);
process.stdin.on("end", () => {
  const payload = JSON.parse(source);
  const projects = payload?.data?.projects;
  if (payload?.code !== 0 || !Array.isArray(projects)) process.exit(2);
  process.stdout.write(String(projects.length));
});')
    project_hash=$(printf '%s' "$response" | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')
    printf '%s\t%s\n' "$project_count" "$project_hash"
}

write_backend_wrapper() {
    mode=$1
    temporary="$runtime_root/FilmOSBackend.wrapper-$$"
    {
        printf '%s\n' '#!/bin/sh' 'set -eu'
        case "$mode" in
            slow)
                printf '%s\n' 'sleep 2'
                printf 'exec "%s" "$@"\n' "$compiled_backend"
                ;;
            fail)
                printf '%s\n' 'echo FILMOS_SOURCE_LIFECYCLE_INJECTED_BACKEND_FAILURE >&2' 'exit 86'
                ;;
            *) fail "INVALID_INJECTION_MODE" ;;
        esac
    } > "$temporary"
    chmod 0755 "$temporary"
    mv "$temporary" "$backend_helper"
}

restore_backend_helper() {
    if [ -f "$backend_backup" ]; then
        install -m 0755 "$backend_backup" "$backend_helper"
    fi
}

cleanup() {
    set +e
    test_launcher stop >/dev/null 2>&1
    restore_backend_helper
    if [ "$finished" = true ]; then
        rm -f "$backend_backup"
    fi
    if [ "$was_running" = true ] && ! source_state_is running; then
        "$launcher" start >/dev/null 2>&1
    fi
}
trap cleanup EXIT HUP INT TERM

[ -x "$python_bin" ] || fail "FILMOS_SOURCE_FILM_CORE_PYTHON_UNAVAILABLE"
[ -x "$double_click_entry" ] || fail "DOUBLE_CLICK_ENTRY_UNAVAILABLE"
if source_state_is running; then
    was_running=true
fi

mkdir -p "$evidence_root"
: > "$trace_path"
printf 'cycle\tstart_mode\thost_pid\tprocess_group\tlistener_count\tlistener_hash\tproject_count\tproject_hash\tduplicate_rc\tstart_duration_ms\tports_released\thost_reaped\tlog_sha256\n' > "$cycles_path"

test_launcher stop >/dev/null
ports_free || fail "PORTS_BUSY_BEFORE_PREPARE"
FILMOS_SOURCE_LIFECYCLE_TEST_MODE=1 "$launcher" prepare > "$evidence_root/prepare.log" 2>&1
[ -x "$backend_helper" ] && [ -x "$compiled_backend" ] || fail "PREPARED_BACKEND_UNAVAILABLE"
install -m 0755 "$backend_helper" "$backend_backup"
data_snapshot "$before_data_path"
trace_event prepare 0 passed "runtime_ready"

baseline_project_hash=""
cycle=1
while [ "$cycle" -le 10 ]; do
    start_mode=clean
    if [ "$cycle" -eq 9 ]; then
        write_backend_wrapper slow
        start_mode=slow_injection
    fi
    start_begin=$(monotonic_ns)
    duplicate_rc=0
    if [ "$cycle" -eq 1 ]; then
        start_mode=double_click_lock
        set +e
        test_double_click_entry > "$evidence_root/cycle-01-primary.log" 2>&1 &
        primary_command_pid=$!
        lock_attempts=0
        while [ ! -d "$runtime_root/start.lock" ] && [ "$lock_attempts" -lt 250 ]; do
            sleep 0.02
            lock_attempts=$((lock_attempts + 1))
        done
        [ -d "$runtime_root/start.lock" ] || fail "DOUBLE_CLICK_LOCK_NOT_OBSERVED"
        test_double_click_entry > "$evidence_root/cycle-01-duplicate.log" 2>&1
        duplicate_rc=$?
        wait "$primary_command_pid"
        primary_rc=$?
        set -e
        [ "$primary_rc" -eq 0 ] || fail "DOUBLE_CLICK_PRIMARY_FAILED"
        case "$duplicate_rc" in 0|1) ;; *) fail "DOUBLE_CLICK_DUPLICATE_UNEXPECTED_RC" ;; esac
        cycle_log="$evidence_root/cycle-01-primary.log"
    else
        cycle_log=$(printf '%s/cycle-%02d-start.log' "$evidence_root" "$cycle")
        test_launcher start > "$cycle_log" 2>&1
    fi
    start_end=$(monotonic_ns)
    start_duration_ms=$(((start_end - start_begin) / 1000000))

    source_state_is running || fail "CYCLE_${cycle}_NOT_RUNNING"
    host_pid=$(sed -n '1p' "$runtime_root/host.pid")
    case "$host_pid" in ''|*[!0-9]*) fail "CYCLE_${cycle}_INVALID_PID" ;; esac
    kill -0 "$host_pid" 2>/dev/null || fail "CYCLE_${cycle}_HOST_NOT_ALIVE"
    process_group=$(/bin/ps -o pgid= -p "$host_pid" | /usr/bin/awk '{print $1}')
    [ -n "$process_group" ] || fail "CYCLE_${cycle}_PROCESS_GROUP_MISSING"

    /usr/bin/curl -fsS --max-time 5 http://127.0.0.1:43100/ >/dev/null
    /usr/bin/curl -fsS --max-time 5 http://127.0.0.1:43101/api/health >/dev/null
    /usr/bin/curl -fsS --max-time 5 http://127.0.0.1:17371/health >/dev/null
    /usr/bin/curl -fsS --max-time 5 http://127.0.0.1:17650/health >/dev/null
    /usr/bin/curl -fsS --max-time 5 http://127.0.0.1:17920/healthz >/dev/null

    listeners=$(listener_pids)
    listener_count=$(printf '%s\n' "$listeners" | /usr/bin/awk 'NF { count += 1 } END { print count + 0 }')
    listener_hash=$(printf '%s\n' "$listeners" | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')
    context=$(project_context)
    project_count=$(printf '%s' "$context" | /usr/bin/awk -F '\t' '{print $1}')
    project_hash=$(printf '%s' "$context" | /usr/bin/awk -F '\t' '{print $2}')
    if [ -z "$baseline_project_hash" ]; then
        baseline_project_hash=$project_hash
    elif [ "$project_hash" != "$baseline_project_hash" ]; then
        fail "CYCLE_${cycle}_PROJECT_CONTEXT_CHANGED"
    fi

    duplicate_before=$host_pid
    set +e
    test_launcher start > "$evidence_root/cycle-$(printf '%02d' "$cycle")-duplicate.log" 2>&1
    ready_duplicate_rc=$?
    set -e
    [ "$ready_duplicate_rc" -eq 0 ] || fail "CYCLE_${cycle}_READY_DUPLICATE_FAILED"
    duplicate_after=$(sed -n '1p' "$runtime_root/host.pid")
    [ "$duplicate_before" = "$duplicate_after" ] || fail "CYCLE_${cycle}_DUPLICATE_REPLACED_HOST"

    test_launcher stop > "$evidence_root/cycle-$(printf '%02d' "$cycle")-stop.log" 2>&1
    ports_released=false
    host_reaped=false
    ports_free && ports_released=true
    if ! kill -0 "$host_pid" 2>/dev/null; then host_reaped=true; fi
    [ "$ports_released" = true ] || fail "CYCLE_${cycle}_PORT_NOT_RELEASED"
    [ "$host_reaped" = true ] || fail "CYCLE_${cycle}_HOST_NOT_REAPED"
    if [ "$cycle" -eq 9 ]; then restore_backend_helper; fi
    log_sha256=$(hash_file "$cycle_log")
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$cycle" "$start_mode" "$host_pid" "$process_group" "$listener_count" "$listener_hash" \
        "$project_count" "$project_hash" "$duplicate_rc" "$start_duration_ms" \
        "$ports_released" "$host_reaped" "$log_sha256" >> "$cycles_path"
    trace_event cycle "$cycle" passed "$start_mode"
    cycle=$((cycle + 1))
done

write_backend_wrapper fail
failure_begin=$(monotonic_ns)
set +e
test_launcher start > "$evidence_root/failure-injection.log" 2>&1
failure_rc=$?
set -e
failure_end=$(monotonic_ns)
failure_duration_ms=$(((failure_end - failure_begin) / 1000000))
[ "$failure_rc" -ne 0 ] || fail "FAILURE_INJECTION_STARTED_SUCCESSFULLY"
ports_free || fail "FAILURE_INJECTION_PORT_NOT_RELEASED"
source_state_is stopped || fail "FAILURE_INJECTION_HOST_NOT_STOPPED"
[ ! -e "$runtime_root/start.lock" ] || fail "FAILURE_INJECTION_LOCK_NOT_RELEASED"
trace_event failure_injection 11 passed "exit_$failure_rc"

restore_backend_helper
test_launcher start > "$evidence_root/failure-recovery-start.log" 2>&1
/usr/bin/curl -fsS --max-time 5 http://127.0.0.1:43101/api/health >/dev/null
recovery_context=$(project_context)
recovery_project_hash=$(printf '%s' "$recovery_context" | /usr/bin/awk -F '\t' '{print $2}')
[ "$recovery_project_hash" = "$baseline_project_hash" ] || fail "FAILURE_RECOVERY_PROJECT_CONTEXT_CHANGED"
recovery_pid=$(sed -n '1p' "$runtime_root/host.pid")
test_launcher stop > "$evidence_root/failure-recovery-stop.log" 2>&1
ports_free || fail "FAILURE_RECOVERY_PORT_NOT_RELEASED"
if kill -0 "$recovery_pid" 2>/dev/null; then fail "FAILURE_RECOVERY_HOST_NOT_REAPED"; fi
trace_event failure_recovery 12 passed "project_context_restored"

data_snapshot "$after_data_path"
/usr/bin/cmp -s "$before_data_path" "$after_data_path" || fail "CANONICAL_PROJECT_DATA_CHANGED"
app_build_count=$(find "$runtime_root" -type d -name '*.app' -print | /usr/bin/awk 'END { print NR + 0 }')
[ "$app_build_count" -eq 0 ] || fail "APP_BUNDLE_CREATED"

"$node_bin" - "$cycles_path" "$before_data_path" "$after_data_path" "$trace_path" "$result_path" "$failure_rc" "$failure_duration_ms" "$app_build_count" <<'NODE'
const { createHash } = require("node:crypto");
const { readFileSync, renameSync, writeFileSync } = require("node:fs");
const [cyclesPath, beforePath, afterPath, tracePath, resultPath, failureRC, failureDurationMS, appBuildCount] = process.argv.slice(2);
const [header, ...rows] = readFileSync(cyclesPath, "utf8").trim().split("\n").map((line) => line.split("\t"));
const cycles = rows.map((row) => Object.fromEntries(header.map((key, index) => {
  const raw = row[index];
  if (["cycle", "host_pid", "process_group", "listener_count", "project_count", "duplicate_rc", "start_duration_ms"].includes(key)) return [key, Number(raw)];
  if (["ports_released", "host_reaped"].includes(key)) return [key, raw === "true"];
  return [key, raw];
})));
const sha256 = (path) => createHash("sha256").update(readFileSync(path)).digest("hex");
const result = {
  schema_version: "filmos.source-lifecycle-result.v1",
  status: "PASS",
  successful_cold_cycles: cycles.length,
  cycles,
  failure_injection: {
    observed: true,
    launcher_exit_code: Number(failureRC),
    duration_ms: Number(failureDurationMS),
    services_reaped: true,
    ports_released: true,
    restart_recovered: true,
  },
  data_before: JSON.parse(readFileSync(beforePath, "utf8")),
  data_after: JSON.parse(readFileSync(afterPath, "utf8")),
  project_context_recovered_every_cycle: true,
  duplicate_start_suppressed_every_cycle: true,
  double_click_lock_verified: true,
  slow_start_verified: cycles.some((cycle) => cycle.start_mode === "slow_injection" && cycle.start_duration_ms >= 1900),
  app_build_count: Number(appBuildCount),
  packaged_app_service_start_finding: "DEFERRED_BY_SOURCE_FIRST_POLICY",
  model_api_call_count: 0,
  paid_provider_call_count: 0,
  generation_count: 0,
  upload_count: 0,
  external_project_creation_count: 0,
  trace_sha256: sha256(tracePath),
};
if (cycles.length !== 10 || !result.slow_start_verified || result.app_build_count !== 0) process.exit(3);
const temporary = `${resultPath}.tmp-${process.pid}`;
writeFileSync(temporary, `${JSON.stringify(result, null, 2)}\n`, { mode: 0o600 });
renameSync(temporary, resultPath);
NODE

result_sha256=$(hash_file "$result_path")
trace_sha256=$(hash_file "$trace_path")
"$node_bin" - "$runtime_root/Resources/SourceIdentity.json" "$result_path" "$receipt_path" "$result_sha256" "$trace_sha256" "$before_data_path" <<'NODE'
const { readFileSync, renameSync, writeFileSync } = require("node:fs");
const [identityPath, resultPath, receiptPath, resultSHA256, traceSHA256, dataPath] = process.argv.slice(2);
const identity = JSON.parse(readFileSync(identityPath, "utf8"));
const result = JSON.parse(readFileSync(resultPath, "utf8"));
const receipt = {
  schema_version: "filmos.source-lifecycle-receipt.v1",
  status: result.status,
  build: identity.build_id,
  commit: identity.git_commit_sha,
  tree: identity.git_tree_sha,
  source_fingerprint_sha256: identity.source_fingerprint_sha256,
  source_clean: identity.source_clean,
  release_channel: identity.release_channel,
  result_sha256: resultSHA256,
  trace_sha256: traceSHA256,
  data_snapshot: JSON.parse(readFileSync(dataPath, "utf8")),
  successful_cold_cycles: result.successful_cold_cycles,
  app_build_count: result.app_build_count,
  packaged_app_service_start_finding: result.packaged_app_service_start_finding,
};
const temporary = `${receiptPath}.tmp-${process.pid}`;
writeFileSync(temporary, `${JSON.stringify(receipt, null, 2)}\n`, { mode: 0o600 });
renameSync(temporary, receiptPath);
NODE

receipt_sha256=$(hash_file "$receipt_path")
finished=true
rm -f "$backend_backup"
trap - EXIT HUP INT TERM
if [ "$was_running" = true ]; then "$launcher" start >/dev/null; fi
"$node_bin" -e 'process.stdout.write(`${JSON.stringify({
  status: "PASS",
  receipt_path: process.argv[1],
  receipt_sha256: process.argv[2],
  trace_sha256: process.argv[3],
  result_sha256: process.argv[4],
  successful_cold_cycles: 10,
  app_build_count: 0,
})}\n`)' "$receipt_path" "$receipt_sha256" "$trace_sha256" "$result_sha256"
