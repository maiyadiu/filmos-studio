#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
VENV="$ROOT/.local/acceptance-venv"

command -v bun >/dev/null
command -v go >/dev/null
command -v node >/dev/null
command -v npm >/dev/null
command -v python3 >/dev/null
command -v swift >/dev/null

if [ ! -x "$VENV/bin/python" ]; then
    python3 -m venv "$VENV"
fi
if ! "$VENV/bin/python" -c 'import fastapi,film_production_core,httpx,jsonschema,pydantic,pytest,uvicorn,PyInstaller' >/dev/null 2>&1; then
    "$VENV/bin/python" -m pip install --disable-pip-version-check -e "$ROOT/film-core[test]" 'pyinstaller>=6.20,<7'
fi
(cd "$ROOT/web" && bun install --frozen-lockfile)
(cd "$ROOT/canvas-agent" && bun install --frozen-lockfile)
if [ ! -x "$ROOT/packages/filmos-agent-tool-contracts/node_modules/.bin/tsx" ]; then
    (cd "$ROOT/packages/filmos-agent-tool-contracts" && npm ci --ignore-scripts)
fi
(cd "$ROOT/packages/filmos-agent-tool-contracts" && npm run build)
if [ ! -x "$ROOT/packages/filmos-tool-contracts/node_modules/.bin/tsc" ]; then
    (cd "$ROOT/packages/filmos-tool-contracts" && npm ci --ignore-scripts)
fi
(cd "$ROOT/packages/filmos-tool-contracts" && npm run build)
if [ ! -x "$ROOT/services/filmos-chatgpt-app/node_modules/.bin/tsx" ]; then
    (cd "$ROOT/services/filmos-chatgpt-app" && npm ci --ignore-scripts)
fi

printf '%s\n' "ACCEPTANCE_BOOTSTRAP_READY"
