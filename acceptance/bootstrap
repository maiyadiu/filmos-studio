#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
VENV="$ROOT/.local/acceptance-venv"

command -v bun >/dev/null
command -v go >/dev/null
command -v node >/dev/null
command -v npm >/dev/null
command -v python3 >/dev/null
command -v swift >/dev/null

if [ ! -x "$VENV/bin/python" ]; then
    python3 -m venv "$VENV"
fi
if ! "$VENV/bin/python" -c 'import fastapi,film_production_core,httpx,jsonschema,pydantic,pytest,uvicorn,PyInstaller' >/dev/null 2>&1; then
    "$VENV/bin/python" -m pip install --disable-pip-version-check -e "$ROOT/film-core[test]" 'pyinstaller>=6.20,<7'
fi
(cd "$ROOT/web" && bun install --frozen-lockfile)
(cd "$ROOT/canvas-agent" && bun install --frozen-lockfile)
if [ ! -x "$ROOT/packages/filmos-agent-tool-contracts/node_modules/.bin/tsx" ]; then
    (cd "$ROOT/packages/filmos-agent-tool-contracts" && npm ci --ignore-scripts)
fi
(cd "$ROOT/packages/filmos-agent-tool-contracts" && npm run build)
if [ ! -x "$ROOT/packages/filmos-generation-contracts/node_modules/.bin/tsc" ]; then
    (cd "$ROOT/packages/filmos-generation-contracts" && npm ci --ignore-scripts)
fi
(cd "$ROOT/packages/filmos-generation-contracts" && npm test)
# Bun materializes `file:` dependencies as package snapshots. On a clean clone
# the first install happens before the generated package has a dist/ directory,
# so refresh the built runtime files in each consumer without relying on a
# developer machine's historical node_modules contents.
for consumer in "$ROOT/web" "$ROOT/canvas-agent"; do
    target="$consumer/node_modules/@filmos/agent-tool-contracts/dist"
    mkdir -p "$target"
    for artifact in "$ROOT/packages/filmos-agent-tool-contracts/dist/"*.js \
        "$ROOT/packages/filmos-agent-tool-contracts/dist/"*.d.ts; do
        filename=$(basename -- "$artifact")
        if [ ! -f "$target/$filename" ] || ! cmp -s "$artifact" "$target/$filename"; then
            cp "$artifact" "$target/$filename"
        fi
    done
done
generation_target="$ROOT/web/node_modules/@filmos/generation-contracts/dist"
mkdir -p "$generation_target"
for artifact in "$ROOT/packages/filmos-generation-contracts/dist/"*.js \
    "$ROOT/packages/filmos-generation-contracts/dist/"*.d.ts; do
    filename=$(basename -- "$artifact")
    if [ ! -f "$generation_target/$filename" ] || ! cmp -s "$artifact" "$generation_target/$filename"; then
        cp "$artifact" "$generation_target/$filename"
    fi
done
if [ ! -x "$ROOT/packages/filmos-tool-contracts/node_modules/.bin/tsc" ]; then
    (cd "$ROOT/packages/filmos-tool-contracts" && npm ci --ignore-scripts)
fi
(cd "$ROOT/packages/filmos-tool-contracts" && npm run build)
if [ ! -x "$ROOT/services/filmos-chatgpt-app/node_modules/.bin/tsx" ]; then
    (cd "$ROOT/services/filmos-chatgpt-app" && npm ci --ignore-scripts)
fi

printf '%s\n' "ACCEPTANCE_BOOTSTRAP_READY"
