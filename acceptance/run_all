#!/bin/sh
set -eu

if [ "${1:-}" != "--authorize-app-acceptance" ] || [ "$#" -ne 1 ]; then
    printf '%s\n' "APP_ACCEPTANCE_AUTHORIZATION_REQUIRED: run_all builds an App. Use acceptance/run.py --suite source for ordinary development." >&2
    exit 2
fi

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${FILMOS_ACCEPTANCE_ALLOW_DIRTY:-0}" != "1" ] && [ -n "$(git -C "$ROOT" status --porcelain)" ]; then
    printf '%s\n' "Formal acceptance requires a clean worktree. Set FILMOS_ACCEPTANCE_ALLOW_DIRTY=1 only for development evidence." >&2
    exit 2
fi

"$ROOT/acceptance/bootstrap"
PATH_FILE=$(mktemp "${TMPDIR:-/tmp}/filmos-acceptance.XXXXXX")
trap 'rm -f "$PATH_FILE"' EXIT HUP INT TERM

ARTIFACT_ROOT=${FILMOS_ACCEPTANCE_ARTIFACT_ROOT:-"$ROOT/.local/acceptance-artifacts"}
EVIDENCE_ROOT=${FILMOS_ACCEPTANCE_EVIDENCE_ROOT:-"$ARTIFACT_ROOT/runs"}
RELEASE_MANIFEST="$ARTIFACT_ROOT/RELEASE_MANIFEST.json"
HANDOFF_ARTIFACT_ROOT="$ARTIFACT_ROOT"
UI_GOLDEN_ROOT="$ARTIFACT_ROOT/ui-golden"
mkdir -p "$EVIDENCE_ROOT"

if [ -n "${FILMOS_V1_1_EXTERNAL_LIVE_TRACE:-}" ]; then
    if [ -e "$UI_GOLDEN_ROOT" ]; then
        printf '%s\n' "formal UI Golden root must not already exist: $UI_GOLDEN_ROOT" >&2
        exit 2
    fi
    export FILMOS_ACCEPTANCE_UI_GOLDEN_CAPTURE_ROOT="$UI_GOLDEN_ROOT"
fi

"$ROOT/.local/acceptance-venv/bin/python" "$ROOT/acceptance/run.py" \
    --suite rc-local \
    --authorize-app-acceptance \
    --evidence-root "$EVIDENCE_ROOT" \
    --receipt-path-file "$PATH_FILE"
RECEIPT=$(sed -n '1p' "$PATH_FILE")
"$ROOT/.local/acceptance-venv/bin/python" "$ROOT/acceptance/verify.py" "$RECEIPT"

CLEAN=$(
    "$ROOT/.local/acceptance-venv/bin/python" -c \
        'import json,sys; print("1" if json.load(open(sys.argv[1], encoding="utf-8"))["clean_worktree"] else "0")' \
        "$RECEIPT"
)
if [ "$CLEAN" = "1" ]; then
    if [ -n "${FILMOS_ACCEPTANCE_BUILD_ID:-}" ]; then
        "$ROOT/.local/acceptance-venv/bin/python" \
            "$ROOT/acceptance/generate_release_manifest.py" \
            --receipt "$RECEIPT" \
            --output "$RELEASE_MANIFEST" \
            --build-id "$FILMOS_ACCEPTANCE_BUILD_ID"
    else
        "$ROOT/.local/acceptance-venv/bin/python" \
            "$ROOT/acceptance/generate_release_manifest.py" \
            --receipt "$RECEIPT" \
            --output "$RELEASE_MANIFEST"
    fi
    "$ROOT/.local/acceptance-venv/bin/python" \
        "$ROOT/acceptance/verify_release_manifest.py" \
        "$RELEASE_MANIFEST" "$RECEIPT"
    cp "$ROOT/acceptance/EVIDENCE_INDEX.json" "$ARTIFACT_ROOT/EVIDENCE_INDEX.json"
    if [ -n "${FILMOS_V1_1_EXTERNAL_LIVE_TRACE:-}" ]; then
        "$ROOT/.local/acceptance-venv/bin/python" \
            "$ROOT/acceptance/checks/ui_golden.py" finalize \
            --capture-root "$UI_GOLDEN_ROOT" \
            --release-manifest "$RELEASE_MANIFEST"
        "$ROOT/.local/acceptance-venv/bin/python" \
            "$ROOT/acceptance/build_use_driven_dual_expert_handoff.py" \
            --receipt "$RECEIPT" \
            --release-manifest "$RELEASE_MANIFEST" \
            --artifact-root "$HANDOFF_ARTIFACT_ROOT" \
            --live-trace "$FILMOS_V1_1_EXTERNAL_LIVE_TRACE" \
            --ui-root "$UI_GOLDEN_ROOT/ui" \
            --ui-freshness "$UI_GOLDEN_ROOT/UI_GOLDEN_FRESHNESS.json"
    fi
fi

printf '%s\n' "$RECEIPT"
if [ "$CLEAN" = "1" ]; then
    printf '%s\n' "$RELEASE_MANIFEST"
fi
