{
  "name": "@filmos/chatgpt-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build:contracts": "npm --prefix ../../packages/filmos-tool-contracts run build",
    "build": "npm run build:contracts && tsc -p tsconfig.json",
    "check": "npm run build:contracts && tsc -p tsconfig.json --noEmit",
    "test": "npm run build:contracts && tsx --test --test-concurrency=1 test/*.test.ts",
    "start": "node dist/server.js",
    "doctor": "node dist/doctor.js",
    "grant": "node dist/grant-cli.js"
  },
  "dependencies": {
    "@filmos/tool-contracts": "file:../../packages/filmos-tool-contracts",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
