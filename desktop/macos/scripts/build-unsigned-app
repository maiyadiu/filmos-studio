#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
package_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
workspace_root=$(CDPATH= cd -- "$package_dir/../.." && pwd)
destination=${1:-"$package_dir/.local/FilmOS Studio.app"}
web_port=${FILMOS_DESKTOP_WEB_PORT:-43100}
backend_port=${FILMOS_DESKTOP_BACKEND_PORT:-43101}
application_support_directory_name=${FILMOS_DESKTOP_APPLICATION_SUPPORT_DIRECTORY_NAME:-FilmOS Studio}
icon_source="$package_dir/App/FilmOS图标.png"
bun_executable=$(command -v bun || true)
go_executable=$(command -v go || true)
acceptance_python="$workspace_root/.local/acceptance-venv/bin/python"
if [ -x "$acceptance_python" ]; then
    python_executable="$acceptance_python"
else
    python_executable=$(command -v python3 || true)
fi

case "$destination" in
    *.app) ;;
    *)
        echo "output must end with .app" >&2
        exit 2
        ;;
esac

case "$web_port:$backend_port" in
    *[!0-9:]*|:|*:|*::* )
        echo "desktop ports must be explicit integers" >&2
        exit 2
        ;;
esac
if [ "$web_port" -lt 1024 ] || [ "$web_port" -gt 65535 ] || [ "$backend_port" -lt 1024 ] || [ "$backend_port" -gt 65535 ] || [ "$web_port" -eq "$backend_port" ]; then
    echo "desktop ports must be distinct user ports" >&2
    exit 2
fi
case "$application_support_directory_name" in
    ""|.|..|*/*|*:*)
        echo "desktop application support directory name is invalid" >&2
        exit 2
        ;;
esac

if [ -e "$destination" ]; then
    echo "refusing to overwrite existing bundle: $destination" >&2
    exit 2
fi

if [ -z "$bun_executable" ] || [ ! -x "$bun_executable" ]; then
    echo "bun is required to build the bundled web workbench" >&2
    exit 1
fi
if [ -z "$go_executable" ] || [ ! -x "$go_executable" ]; then
    echo "go is required to bundle the internal backend" >&2
    exit 1
fi
if [ -z "$python_executable" ] || [ ! -x "$python_executable" ] || ! "$python_executable" -c 'import PyInstaller' >/dev/null 2>&1; then
    echo "Python with PyInstaller is required to bundle Film Core" >&2
    exit 1
fi
if [ ! -f "$workspace_root/web/node_modules/vite/bin/vite.js" ]; then
    echo "web dependencies are missing; install them before building the app" >&2
    exit 1
fi
if [ ! -f "$icon_source" ]; then
    echo "app icon master is missing: $icon_source" >&2
    exit 1
fi

swift build --package-path "$package_dir" -c release
binary_dir=$(swift build --package-path "$package_dir" -c release --show-bin-path)
binary="$binary_dir/FilmOSStudioDesktop"
if [ ! -x "$binary" ]; then
    echo "release executable missing: $binary" >&2
    exit 1
fi

destination_parent=$(dirname -- "$destination")
mkdir -p "$destination_parent"
staging=$(mktemp -d "$destination_parent/.filmos-app.XXXXXX")
bun_artifact_manifest="$staging/bun-build-artifacts.before"
find "$workspace_root/services/filmos-chatgpt-app" -maxdepth 1 -type f -name '.*.bun-build' -print | LC_ALL=C sort >"$bun_artifact_manifest"
cleanup_bun_build_artifacts() {
    find "$workspace_root/services/filmos-chatgpt-app" -maxdepth 1 -type f -name '.*.bun-build' -print | while IFS= read -r artifact; do
        if ! grep -F -x -q "$artifact" "$bun_artifact_manifest"; then
            rm -f -- "$artifact"
        fi
    done
}
cleanup() {
    cleanup_bun_build_artifacts
    find "$staging" -type f -delete 2>/dev/null || true
    find "$staging" -depth -type d -empty -delete 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

bundle="$staging/FilmOS Studio.app"
mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Helpers" "$bundle/Contents/Resources"

(
    cd "$workspace_root/web"
    "$bun_executable" run build
)

(
    cd "$workspace_root/services/filmos-chatgpt-app"
    # The linked package's dist/ directory is generated and intentionally not
    # committed. Build it here so a clean clone has the same inputs as a local
    # developer checkout before Bun resolves @filmos/tool-contracts.
    npm run build:contracts
    npm run build:widget
    "$bun_executable" build --compile src/server.ts --outfile "$staging/FilmOSChatGPTMCP"
    "$bun_executable" build --compile src/grant-cli.ts --outfile "$staging/FilmOSChatGPTGrant"
)

"$python_executable" -m PyInstaller \
    --noconfirm \
    --clean \
    --onefile \
    --name FilmOSFilmCore \
    --distpath "$staging/pyinstaller-dist" \
    --workpath "$staging/pyinstaller-work" \
    --specpath "$staging/pyinstaller-spec" \
    --paths "$workspace_root/film-core/src" \
    --collect-submodules film_production_core \
    --collect-submodules uvicorn \
    "$package_dir/runtime/film-core-launcher.py" >/dev/null
test -x "$staging/pyinstaller-dist/FilmOSFilmCore"

tunnel_archive_cache=${FILMOS_TUNNEL_CLIENT_ARCHIVE_CACHE:-"$workspace_root/.local/final-external-gates/bdec33ce/chatgpt-handoff-external/tunnel-client-download/tunnel-client-v0.0.13-darwin-arm64.zip"}
if [ -f "$tunnel_archive_cache" ] && [ "$(uname -m)" = "arm64" ]; then
    FILMOS_TUNNEL_CLIENT_ARCHIVE_CACHE="$tunnel_archive_cache" \
        "$package_dir/scripts/install-tunnel-client" "$staging/tunnel-client-runtime"
else
    "$package_dir/scripts/install-tunnel-client" "$staging/tunnel-client-runtime"
fi
if [ ! -f "$workspace_root/web/dist/index.html" ]; then
    echo "web production build is missing index.html" >&2
    exit 1
fi
grep -q 'name="filmos-workbench" content="v1"' "$workspace_root/web/dist/index.html"

(
    cd "$workspace_root/backend"
    "$go_executable" build -trimpath -o "$staging/FilmOSBackend" ./cmd/server
    "$go_executable" build -trimpath -o "$staging/FilmOSWeb" ./cmd/desktop-web
)

iconset="$staging/FilmOSStudio.iconset"
mkdir -p "$iconset"
sips -z 16 16 "$icon_source" --out "$iconset/icon_16x16.png" >/dev/null
sips -z 32 32 "$icon_source" --out "$iconset/icon_16x16@2x.png" >/dev/null
sips -z 32 32 "$icon_source" --out "$iconset/icon_32x32.png" >/dev/null
sips -z 64 64 "$icon_source" --out "$iconset/icon_32x32@2x.png" >/dev/null
sips -z 128 128 "$icon_source" --out "$iconset/icon_128x128.png" >/dev/null
sips -z 256 256 "$icon_source" --out "$iconset/icon_128x128@2x.png" >/dev/null
sips -z 256 256 "$icon_source" --out "$iconset/icon_256x256.png" >/dev/null
sips -z 512 512 "$icon_source" --out "$iconset/icon_256x256@2x.png" >/dev/null
sips -z 512 512 "$icon_source" --out "$iconset/icon_512x512.png" >/dev/null
sips -z 1024 1024 "$icon_source" --out "$iconset/icon_512x512@2x.png" >/dev/null
iconutil -c icns "$iconset" -o "$staging/FilmOSStudio.icns"

runtime_plist="$staging/InternalRuntime.plist"
plutil -create xml1 "$runtime_plist"
plutil -insert schema_version -integer 2 "$runtime_plist"
plutil -insert start_url -string "http://127.0.0.1:$web_port/create" "$runtime_plist"
plutil -insert web_health_url -string "http://127.0.0.1:$web_port/" "$runtime_plist"
plutil -insert backend_health_url -string "http://127.0.0.1:$backend_port/api/health" "$runtime_plist"
plutil -insert application_support_directory_name -string "$application_support_directory_name" "$runtime_plist"
plutil -insert backend_data_directory_name -string "WorkbenchData" "$runtime_plist"
plutil -convert json -o "$staging/InternalRuntime.json" "$runtime_plist"

install -m 0755 "$binary" "$bundle/Contents/MacOS/FilmOSStudioDesktop"
install -m 0755 "$staging/FilmOSBackend" "$bundle/Contents/Helpers/FilmOSBackend"
install -m 0755 "$staging/FilmOSWeb" "$bundle/Contents/Helpers/FilmOSWeb"
install -m 0755 "$staging/pyinstaller-dist/FilmOSFilmCore" "$bundle/Contents/Helpers/FilmOSFilmCore"
install -m 0755 "$staging/FilmOSChatGPTMCP" "$bundle/Contents/Helpers/FilmOSChatGPTMCP"
install -m 0755 "$staging/FilmOSChatGPTGrant" "$bundle/Contents/Helpers/FilmOSChatGPTGrant"
install -m 0755 "$staging/tunnel-client-runtime/tunnel-client" "$bundle/Contents/Helpers/tunnel-client"
install -m 0755 "$staging/tunnel-client-runtime/cloudflared" "$bundle/Contents/Helpers/cloudflared"
install -m 0644 "$package_dir/App/Info.plist" "$bundle/Contents/Info.plist"
install -m 0644 "$staging/FilmOSStudio.icns" "$bundle/Contents/Resources/FilmOSStudio.icns"
install -m 0644 "$staging/InternalRuntime.json" "$bundle/Contents/Resources/InternalRuntime.json"
/usr/bin/ditto "$workspace_root/web/dist" "$bundle/Contents/Resources/Web"
/usr/bin/plutil -lint "$bundle/Contents/Info.plist" >/dev/null
runtime="$bundle/Contents/Resources/InternalRuntime.json"
test "$(/usr/bin/plutil -extract schema_version raw -o - "$runtime")" = "2"
test "$(/usr/bin/plutil -extract application_support_directory_name raw -o - "$runtime")" = "$application_support_directory_name"
test -n "$(/usr/bin/plutil -extract start_url raw -o - "$runtime")"
mv "$bundle" "$destination"

cleanup_bun_build_artifacts
trap - EXIT HUP INT TERM
find "$staging" -depth -type d -empty -delete 2>/dev/null || true
printf 'UNSIGNED_APP_READY %s\n' "$destination"
