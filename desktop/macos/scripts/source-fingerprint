#!/usr/bin/env python3
"""Compute the canonical source fingerprint embedded in the local macOS app."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import stat
import subprocess
from pathlib import Path


ROOT = Path(__file__).resolve().parents[3]
DOMAIN = b"FilmOS Desktop Source Fingerprint v1\0"
SOURCE_SCOPES = (
    "backend",
    "canvas-agent",
    "desktop/macos",
    "film-core",
    "packages",
    "services/filmos-chatgpt-app",
    "services/filmos-review-bus",
    "governance/FILMOS_CONSTITUTION.json",
    "web",
    "scripts/agent_runtime_profile.py",
    "scripts/filmos-source-start",
    "scripts/filmos-source-helper",
    "scripts/source-runtime-metadata.mjs",
    "源码启动.command",
)


def git(*args: str) -> str:
    result = subprocess.run(
        ("git", "-C", str(ROOT), *args),
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    return result.stdout.strip()


def listed_items(*selection: str) -> list[str]:
    result = subprocess.run(
        (
            "git",
            "-C",
            str(ROOT),
            "ls-files",
            "-z",
            *selection,
            "--",
            *SOURCE_SCOPES,
        ),
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    items = [item.decode("utf-8") for item in result.stdout.split(b"\0") if item]
    # Bun compile creates short-lived hidden `.*.bun-build` files inside source
    # packages. They are deleted by the app builder and are never source input.
    items = [
        item
        for item in items
        if not (Path(item).name.startswith(".") and Path(item).name.endswith(".bun-build"))
    ]
    return sorted(items)


def source_paths() -> list[Path]:
    items = listed_items("--cached", "--others", "--exclude-standard")
    return [ROOT / item for item in items]


def fingerprint(paths: list[Path]) -> str:
    digest = hashlib.sha256(DOMAIN)
    for path in paths:
        relative = path.relative_to(ROOT).as_posix()
        metadata = path.lstat()
        digest.update(relative.encode("utf-8"))
        digest.update(b"\0")
        digest.update(f"{stat.S_IMODE(metadata.st_mode):04o}".encode("ascii"))
        digest.update(b"\0")
        if path.is_symlink():
            digest.update(b"symlink\0")
            digest.update(os.readlink(path).encode("utf-8"))
        elif path.is_file():
            digest.update(b"file\0")
            digest.update(hashlib.sha256(path.read_bytes()).digest())
        else:
            raise RuntimeError(f"unsupported source input: {relative}")
        digest.update(b"\0")
    return digest.hexdigest()


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    paths = source_paths()
    tracked_status = git("status", "--porcelain", "--untracked-files=no", "--", *SOURCE_SCOPES)
    untracked_sources = listed_items("--others", "--exclude-standard")
    payload = {
        "schema_version": "1.0.0",
        "source_fingerprint_sha256": fingerprint(paths),
        "git_commit_sha": git("rev-parse", "HEAD"),
        "git_tree_sha": git("rev-parse", "HEAD^{tree}"),
        "source_file_count": len(paths),
        "source_scopes": list(SOURCE_SCOPES),
        "source_clean": not bool(tracked_status or untracked_sources),
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
    else:
        print(payload["source_fingerprint_sha256"])


if __name__ == "__main__":
    main()
