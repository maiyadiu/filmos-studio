#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
workspace_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd)
bundle=${1:-}
if [ -z "$bundle" ] || [ ! -d "$bundle" ]; then
    echo "usage: verify-unsigned-app <FilmOS Studio.app>" >&2
    exit 2
fi

plist="$bundle/Contents/Info.plist"
binary="$bundle/Contents/MacOS/FilmOSStudioDesktop"
backend="$bundle/Contents/Helpers/FilmOSBackend"
web_server="$bundle/Contents/Helpers/FilmOSWeb"
film_core="$bundle/Contents/Helpers/FilmOSFilmCore"
chatgpt_mcp="$bundle/Contents/Helpers/FilmOSChatGPTMCP"
chatgpt_grant="$bundle/Contents/Helpers/FilmOSChatGPTGrant"
local_runtime="$bundle/Contents/Helpers/FilmOSLocalRuntime"
canvas_agent_mcp="$bundle/Contents/Helpers/FilmOSCanvasAgentMCP"
review_bus="$bundle/Contents/Helpers/FilmOSReviewBus"
tunnel_client="$bundle/Contents/Helpers/tunnel-client"
cloudflared="$bundle/Contents/Helpers/cloudflared"
icon="$bundle/Contents/Resources/FilmOSStudio.icns"
runtime="$bundle/Contents/Resources/InternalRuntime.json"
source_identity="$bundle/Contents/Resources/SourceIdentity.json"
constitution="$bundle/Contents/Resources/FILMOS_CONSTITUTION.json"
web_root="$bundle/Contents/Resources/Web"
/usr/bin/plutil -lint "$plist" >/dev/null

runtime_value() {
    /usr/bin/plutil -extract "$1" raw -o - "$runtime"
}

runtime_lacks() {
    ! /usr/bin/plutil -extract "$1" raw -o - "$runtime" >/dev/null 2>&1
}

test "$(runtime_value schema_version)" = "4"
expected_support_name=${FILMOS_EXPECTED_APPLICATION_SUPPORT_DIRECTORY_NAME:-FilmOS Studio}
test "$(runtime_value application_support_directory_name)" = "$expected_support_name"
test "$(runtime_value backend_data_directory_name)" = "WorkbenchData"
case "$(runtime_value release_channel)" in development|candidate|pilot|stable) ;; *) exit 1 ;; esac
test -n "$(runtime_value build_id)"
printf '%s\n' "$(runtime_value source_commit)" | grep -Eq '^[0-9a-f]{40,64}$'
printf '%s\n' "$(runtime_value source_tree)" | grep -Eq '^[0-9a-f]{40,64}$'
printf '%s\n' "$(runtime_value source_fingerprint_sha256)" | grep -Eq '^[0-9a-f]{64}$'
test "$(runtime_value source_repository)" = "maiyadiu/filmos-studio"
case "$(runtime_value review_bus_health_url)" in http://127.0.0.1:*/healthz) ;; *) exit 1 ;; esac
case "$(runtime_value review_bus_issue_url)" in http://127.0.0.1:*/v1/issues) ;; *) exit 1 ;; esac
case "$(runtime_value external_paid_submit_enabled)" in true|false) ;; *) exit 1 ;; esac
if [ "$(runtime_value release_channel)" = "pilot" ]; then test "$(runtime_value external_paid_submit_enabled)" = "false"; fi
case "$(runtime_value agent_runtime_profile)" in integration|filmos-candidate) ;; *) exit 1 ;; esac
test "$(runtime_value agent_feature_flags_hash)" != ""
runtime_lacks workspace_root
runtime_lacks bun_executable
runtime_lacks backend_data_directory

expected_bundle_identifier=${FILMOS_EXPECTED_BUNDLE_IDENTIFIER:-com.filmos.studio.localbeta}
expected_display_name=${FILMOS_EXPECTED_APP_DISPLAY_NAME:-FilmOS Studio}
test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$plist")" = "$expected_bundle_identifier"
test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleDisplayName' "$plist")" = "$expected_display_name"
test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$plist")" = "FilmOSStudioDesktop"
test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIconFile' "$plist")" = "FilmOSStudio"
test "$(/usr/libexec/PlistBuddy -c 'Print :NSAppTransportSecurity:NSAllowsLocalNetworking' "$plist")" = "true"
test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleDocumentTypes:0:LSItemContentTypes:0' "$plist")" = "com.filmos.proposal"
test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleDocumentTypes:0:CFBundleTypeExtensions:0' "$plist")" = "filmosproposal"
test "$(/usr/libexec/PlistBuddy -c 'Print :UTExportedTypeDeclarations:0:UTTypeIdentifier' "$plist")" = "com.filmos.proposal"
test "$(/usr/libexec/PlistBuddy -c 'Print :UTExportedTypeDeclarations:1:UTTypeIdentifier' "$plist")" = "com.filmos.backup"
test "$(/usr/libexec/PlistBuddy -c 'Print :UTExportedTypeDeclarations:1:UTTypeTagSpecification:public.filename-extension:0' "$plist")" = "filmosbackup"
test -x "$binary"
test -x "$backend"
test -x "$web_server"
test -x "$film_core"
test -x "$chatgpt_mcp"
test -x "$chatgpt_grant"
test -x "$local_runtime"
test -x "$canvas_agent_mcp"
test -x "$review_bus"
test -x "$tunnel_client"
test -x "$cloudflared"
test -f "$icon"
test -f "$runtime"
test -f "$source_identity"
test -f "$constitution"
test -f "$web_root/index.html"

assert_empty_entitlements() {
    signed_path=$1
    if ! entitlements=$(/usr/bin/codesign -d --entitlements - "$signed_path" 2>/dev/null); then
        echo "could not read code-signing entitlements: $signed_path" >&2
        exit 1
    fi
    if [ -n "$entitlements" ]; then
        echo "unexpected code-signing entitlements: $signed_path" >&2
        exit 1
    fi
}

verify_signed_code() {
    signed_path=$1
    test -x "$signed_path"
    /usr/bin/codesign --verify --strict --verbose=4 "$signed_path"
    /usr/bin/codesign -d "$signed_path" >/dev/null 2>&1
    assert_empty_entitlements "$signed_path"
}

for signed_code in \
    "$backend" \
    "$web_server" \
    "$film_core" \
    "$chatgpt_mcp" \
    "$chatgpt_grant" \
    "$local_runtime" \
    "$canvas_agent_mcp" \
    "$review_bus" \
    "$tunnel_client" \
    "$cloudflared"
do
    verify_signed_code "$signed_code"
done
verify_signed_code "$binary"

/usr/bin/codesign --verify --deep --strict --verbose=4 "$bundle"
bundle_signature=$(/usr/bin/codesign -dvvv -r- "$bundle" 2>&1)
printf '%s\n' "$bundle_signature" | grep -F -q "Identifier=$expected_bundle_identifier"
printf '%s\n' "$bundle_signature" | grep -F -q 'Sealed Resources version='
if printf '%s\n' "$bundle_signature" | grep -F -q 'Info.plist=not bound'; then
    echo "bundle signature does not bind Info.plist" >&2
    exit 1
fi
test -f "$bundle/Contents/_CodeSignature/CodeResources"
assert_empty_entitlements "$bundle"

designated_requirement=$(/usr/bin/codesign -d -r- "$binary" 2>&1 | tail -n 1)
test "$designated_requirement" = "designated => identifier \"$expected_bundle_identifier\""
bundle_designated_requirement=$(/usr/bin/codesign -d -r- "$bundle" 2>&1 | tail -n 1)
test "$bundle_designated_requirement" = "$designated_requirement"
# SourceIdentity is JSON. `plutil -lint` on macOS rejects JSON even though
# `plutil -extract` can parse it, so the field extractions below are the parser
# and schema validation for this file.
test "$(/usr/bin/plutil -extract schema_version raw -o - "$source_identity")" = "1.0.0"
embedded_source_fingerprint=$(/usr/bin/plutil -extract source_fingerprint_sha256 raw -o - "$source_identity")
printf '%s\n' "$embedded_source_fingerprint" | grep -Eq '^[0-9a-f]{64}$'
current_source_fingerprint=$("$script_dir/source-fingerprint")
test "$embedded_source_fingerprint" = "$current_source_fingerprint"
test "$(/usr/bin/plutil -extract git_commit_sha raw -o - "$source_identity")" = "$(git -C "$workspace_root" rev-parse HEAD)"
test "$(/usr/bin/plutil -extract git_tree_sha raw -o - "$source_identity")" = "$(git -C "$workspace_root" rev-parse 'HEAD^{tree}')"
test "$(/usr/bin/plutil -extract build_id raw -o - "$source_identity")" = "$(runtime_value build_id)"
test "$(/usr/bin/plutil -extract release_channel raw -o - "$source_identity")" = "$(runtime_value release_channel)"
test "$(/usr/bin/plutil -extract external_paid_submit_enabled raw -o - "$source_identity")" = "$(runtime_value external_paid_submit_enabled)"
test "$(/usr/bin/plutil -extract repository raw -o - "$source_identity")" = "$(runtime_value source_repository)"
test "$(/usr/bin/plutil -extract git_commit_sha raw -o - "$source_identity")" = "$(runtime_value source_commit)"
test "$(/usr/bin/plutil -extract git_tree_sha raw -o - "$source_identity")" = "$(runtime_value source_tree)"
test "$embedded_source_fingerprint" = "$(runtime_value source_fingerprint_sha256)"
file "$binary" | grep -q 'Mach-O'
file "$backend" | grep -q 'Mach-O'
file "$web_server" | grep -q 'Mach-O'
file "$film_core" | grep -q 'Mach-O'
file "$chatgpt_mcp" | grep -q 'Mach-O'
file "$chatgpt_grant" | grep -q 'Mach-O'
file "$local_runtime" | grep -q 'Mach-O'
file "$canvas_agent_mcp" | grep -q 'Mach-O'
file "$review_bus" | grep -q 'Mach-O'
file "$tunnel_client" | grep -q 'Mach-O'
file "$cloudflared" | grep -q 'Mach-O'

start_url=$(runtime_value start_url)
web_health_url=$(runtime_value web_health_url)
backend_health_url=$(runtime_value backend_health_url)
grep -q 'name="filmos-workbench" content="v1"' "$web_root/index.html"
grep -q '<title>FilmOS Studio</title>' "$web_root/index.html"
case "$start_url" in http://127.0.0.1:*/*) ;; *) exit 1 ;; esac
case "$web_health_url" in http://127.0.0.1:*/) ;; *) exit 1 ;; esac
case "$backend_health_url" in http://127.0.0.1:*/api/health) ;; *) exit 1 ;; esac
test "$start_url" = "${web_health_url}create"
test "$web_health_url" != "${backend_health_url%/api/health}/"
if /usr/bin/grep -E -q '(/Users/|/Downloads/|workspace_root|bun_executable|backend_data_directory")' "$runtime"; then
    echo "runtime configuration must not reference source or protected user directories" >&2
    exit 1
fi

smoke=$(FILMOS_DESKTOP_SMOKE_CHECK=1 "$binary")
test "$smoke" = '{"application":"FilmOS Studio","services_started":false,"smoke_check":true}'

# A Mach-O helper can still be unusable when PyInstaller silently skips a
# missing runtime dependency. Launch the packaged Film Core on an ephemeral
# loopback port and require its real health contract before accepting the app.
film_core_smoke_root=$(mktemp -d "${TMPDIR:-/tmp}/filmos-film-core-smoke.XXXXXX")
film_core_smoke_stdout="$film_core_smoke_root/stdout.log"
film_core_smoke_stderr="$film_core_smoke_root/stderr.log"
film_core_smoke_port=$(/usr/bin/python3 -c 'import socket; server=socket.socket(); server.bind(("127.0.0.1", 0)); print(server.getsockname()[1]); server.close()')
film_core_smoke_pid=
cleanup_film_core_smoke() {
    if [ -n "$film_core_smoke_pid" ] && kill -0 "$film_core_smoke_pid" 2>/dev/null; then
        kill -TERM "$film_core_smoke_pid" 2>/dev/null || true
        wait "$film_core_smoke_pid" 2>/dev/null || true
    fi
    find "$film_core_smoke_root" -type f -delete 2>/dev/null || true
    find "$film_core_smoke_root" -depth -type d -empty -delete 2>/dev/null || true
}
trap cleanup_film_core_smoke EXIT HUP INT TERM
FILMOS_CORE_DB_PATH="$film_core_smoke_root/film-core.sqlite" \
FILMOS_CORE_HOST=127.0.0.1 \
FILMOS_CORE_PORT="$film_core_smoke_port" \
    "$film_core" >"$film_core_smoke_stdout" 2>"$film_core_smoke_stderr" &
film_core_smoke_pid=$!
film_core_smoke_ready=false
film_core_smoke_attempts=0
while [ "$film_core_smoke_attempts" -lt 60 ]; do
    if ! kill -0 "$film_core_smoke_pid" 2>/dev/null; then break; fi
    film_core_health=$(/usr/bin/curl -sS --max-time 1 "http://127.0.0.1:$film_core_smoke_port/health" 2>/dev/null || true)
    case "$film_core_health" in
        *'"ok":true'*'"service":"filmos-film-core"'*) film_core_smoke_ready=true; break ;;
    esac
    sleep 0.25
    film_core_smoke_attempts=$((film_core_smoke_attempts + 1))
done
if [ "$film_core_smoke_ready" != true ]; then
    echo "packaged Film Core failed its real loopback health check" >&2
    tail -n 40 "$film_core_smoke_stderr" >&2 || true
    exit 1
fi
kill -TERM "$film_core_smoke_pid" 2>/dev/null || true
wait "$film_core_smoke_pid" 2>/dev/null || true
film_core_smoke_pid=
cleanup_film_core_smoke
trap - EXIT HUP INT TERM

bundle_hash=$(
    cd "$bundle"
    find Contents/Info.plist Contents/MacOS Contents/Helpers Contents/Resources Contents/_CodeSignature/CodeResources -type f -exec shasum -a 256 {} + \
        | sort \
        | shasum -a 256 \
        | awk '{print $1}'
)
printf 'UNSIGNED_APP_VERIFIED bundle_hash=%s services_started=false film_core_helper_ready=true\n' "$bundle_hash"
